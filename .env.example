# Mail Server Configuration (backend/)
ALLOWED_TO=safety@wildernessdestinations.com
API_KEY=
CORS_ORIGIN=*
MAIL_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=

# Cloudflare Workers configuration (functions/) — set these as Worker secrets,
# and in .dev.vars for local runs. See .dev.vars.example.
#
# ALLOW_INSECURE_ADMIN was listed here and is not: no code reads it. It once
# turned the admin check off entirely, so documenting it as though it still
# worked invited someone to set it and believe the register was open when it
# was shut, or shut when it was open.
ADMIN_USER=
ADMIN_PASSWORD=
SUBMIT_KEY=
